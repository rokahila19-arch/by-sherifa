{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "catalogue",
      "urls": [
        "https://*.supabase.co/rest/v1/products**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "5s",
        "maxSize": 20,
        "maxAge": "7d"
      }
    },
    {
      "name": "product-images",
      "urls": [
        "https://*.supabase.co/storage/v1/object/public/**",
        "https://images.unsplash.com/**",
        "https://cdn.dummyjson.com/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 800,
        "maxAge": "30d"
      }
    }
  ]
}
